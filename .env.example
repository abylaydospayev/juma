JUMA_FQDN=juma.example.com
JUMA_GITHUB_USERNAME=your-github-username
JUMA_ADMIN_SSH_CIDR=203.0.113.10/32
JUMA_PRODUCTION=true
# Juma's general reasoning model is fixed to gpt-5.6-luna.
JUMA_REASONING_EFFORT=medium
JUMA_ENABLE_WEB_SEARCH=true
JUMA_WORKSPACE_ID=default
OAUTH2_PROXY_GITHUB_USER=your-github-username
OAUTH2_PROXY_CLIENT_ID=your-github-oauth-client-id
OAUTH2_PROXY_REDIRECT_URL=https://juma.example.com/oauth2/callback
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
